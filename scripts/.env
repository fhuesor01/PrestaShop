# --- variables de configuracion que usan los scripts de aprovisionamiento
# (!las credenciales son de prueba para un entorno local, modificarlas por las que se deseen)

# --- direcciones ip
IP_VAGRANT="10.0.2.2"        # host de vagrant

# --- base de datos
DB_N="prestashop_db"         # nombre de la bd
DB_U="ps_user"               # nombre del usuario de la bd
DB_P="ps_pass"               # contraseña del usuario de la bd

# --- phpmyadmin y phppsinfo
PMA_P="pma_pass"             # contraseña del usuario interno de phpmyadmin
PSINFO_U="feli"              # usuario para entrar a phppsinfo (cambiamos el de por defecto)
PSINFO_P="psinfo_pass"       # contraseña para entrar a phppsinfo

# --- dominio
DOMINIO="fhuesor01.duckdns.org"

# --- prestashop
PS_V="9.0.0-1.0"             # version de prestashop
PS_T="Tienda Feli"           # nombre de la tienda
PS_N="Feli"                  # nombre del administrador
PS_A="Hueso"                 # apellido del administrador
PS_E="feli@example.com"      # email del administrador (con el que entramos al panel)
PS_P="Feli-Tienda-2026!"     # contraseña del administrador
